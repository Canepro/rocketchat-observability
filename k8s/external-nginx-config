# External Nginx Configuration for Rocket.Chat Load Balancing
# This is a reference configuration based on your production setup
# Place this in your external nginx configuration

# Upstream configuration for Rocket.Chat pods
upstream rocketchat_test_backends {
    zone rocketchat_test_backend_upstreams 64k;
    # Replace with your Kubernetes node IPs and ports
    server 52.183.221.89:80 max_fails=3 fail_timeout=15s;  # Your VM public IP
    # Add more nodes if you have multiple nodes:
    # server k8s-node-2.cloud.example.com:80 max_fails=3 fail_timeout=15s;
    # server k8s-node-3.cloud.example.com:80 max_fails=3 fail_timeout=15s;
    keepalive 16;
}

# Server block for Rocket.Chat
server {
    listen 80;
    server_name 52.183.221.89;  # Your VM public IP

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    add_header Content-Security-Policy "default-src 'self' http: https: data: blob: 'unsafe-inline'" always;

    location / {
        proxy_pass http://rocketchat_test_backends;
        proxy_next_upstream error timeout;
        proxy_next_upstream_tries 3;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;

        # Headers for proper proxying
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;

        proxy_set_header X-Nginx-Proxy true;

        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_redirect off;
        client_max_body_size 0;

        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Health check endpoint (optional)
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
}

